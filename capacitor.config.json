{
  "appId": "com.nori.highwayheatmap",
  "appName": "渋滞ヒートマップ",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "backgroundColor": "#0f172aff"
  },
  "android": {
    "backgroundColor": "#0f172aff"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    }
  }
}
