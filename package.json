{
  "name": "highway-heatmap",
  "version": "1.0.0",
  "description": "高速道路 渋滞ヒートマップ - 出発前にルート×時間で混雑を一望",
  "private": true,
  "scripts": {
    "build:web": "mkdir -p www && cp index.html www/index.html",
